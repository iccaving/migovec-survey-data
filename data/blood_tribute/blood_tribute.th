encoding  utf-8
survey blood_tribute -title "Blood Tribute" -entrance 21@blood_tribute_ent #-attr cadastral_n xxxx
  
  input blood_tribute-p.thm
  input blood_tribute-e.thm

  ###_____________2026_______________###
  input "./2026/blood_tribute_ent/blood_tribute_ent.th"
  input "./2026/hanging_gardens/hanging_gardens.th"
  input "./2026/the_gardened_hang/the_gardened_hang.th"

  equate 0@blood_tribute_ent 0@hanging_gardens
  equate 0@the_gardened_hang 11@hanging_gardens

  # PLAN
  join blood_tribute_ent-1p@blood_tribute_ent hanging_gardens-1p@hanging_gardens
  
  # ELEVATION
  join blood_tribute_ent-1s@blood_tribute_ent hanging_gardens-1s@hanging_gardens
  join hanging_gardens-1s2@hanging_gardens the_gardened_hang-1s@the_gardened_hang

endsurvey